# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# TMDB credentials for movie/TV search. Either the v3 API key or the v4 read access token works.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# HTTP port for the API server (Vite dev server proxies /api here)
PORT=8787

# Network interface for the API server. Keep 127.0.0.1 behind Nginx; use 0.0.0.0 only without a proxy.
HOST=127.0.0.1

# Where cached AI results are stored. Relative paths resolve from the working directory.
# In production, use an absolute path OUTSIDE the git checkout, e.g. /path/to/cache
CACHE_DIR=./data/cache

# Max new AI lookups (cache misses / refreshes) per client IP per hour
AI_LOOKUPS_PER_IP_PER_HOUR=30

# Off-site backup of CACHE_DIR to any S3-compatible bucket (AWS S3, DigitalOcean Spaces,
# Cloudflare R2, Backblaze B2, MinIO). Leave S3_BUCKET empty to turn it off.
# Endpoint examples: https://nyc3.digitaloceanspaces.com, https://<account>.r2.cloudflarestorage.com
# (empty for AWS S3). Keep the bucket private.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=cache/
# 1 for path-style URLs (MinIO and some others)
S3_FORCE_PATH_STYLE=0

# Set to 1 when running behind a reverse proxy (nginx) so the client IP comes from X-Real-IP
# (nginx: proxy_set_header X-Real-IP $remote_addr;), or else from the last X-Forwarded-For entry
TRUST_PROXY=0

# Public origin of the site, e.g. https://your-domain.com. Used for canonical links,
# sitemap.xml, and the Sitemap line in robots.txt. Empty: the request's host, and no Sitemap line.
SITE_URL=

# Contact URL or email for the Open Library User-Agent, e.g. https://your-domain.com.
# With a contact, Open Library allows about 3 requests per second; without one, about 1.
OPENLIBRARY_CONTACT=

# Google OAuth client ID (type "Web application") for the optional Google Drive backup on the
# Preferences page. Read at build time. Leave empty to turn the backup off.
# Add the site's origin (and http://127.0.0.1:5188 for dev) as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
