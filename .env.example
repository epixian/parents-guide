# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# TMDB credentials for movie/TV search. Either the v3 API key or the v4 read access token works.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# HTTP port for the API server (Vite dev server proxies /api here)
PORT=8787

# Network interface for the API server. Keep 127.0.0.1 behind Nginx; use 0.0.0.0 only without a proxy.
HOST=127.0.0.1

# Where cached AI results are stored. Relative paths resolve from the working directory.
# In production, use an absolute path OUTSIDE the git checkout, e.g. /path/to/cache
CACHE_DIR=./data/cache

# Max new AI lookups (cache misses / refreshes) per client IP per hour
AI_LOOKUPS_PER_IP_PER_HOUR=30

# Set to 1 when running behind a reverse proxy (nginx) so the client IP comes from X-Forwarded-For
TRUST_PROXY=0
