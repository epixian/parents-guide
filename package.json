{
  "name": "parents-guide",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Erich Oelschlegel",
  "description": "AI summaries of parental concerns for movies, TV shows, and books",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "batch": "node dist/server/batch.js",
    "batch:dev": "tsx src/server/batch.ts",
    "backfill:mood": "node dist/server/backfillMood.js",
    "backfill:mood:dev": "tsx src/server/backfillMood.ts",
    "backfill:genres": "node dist/server/backfillGenres.js",
    "backfill:genres:dev": "tsx src/server/backfillGenres.ts",
    "backup:sync": "node dist/server/backupSync.js",
    "backup:sync:dev": "tsx src/server/backupSync.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
